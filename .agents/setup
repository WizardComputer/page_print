#!/usr/bin/env bash
set -euo pipefail

step() {
  printf '\n==> %s\n' "$1"
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ruby_version="$(<"$repo_root/.ruby-version")"
bundler_version="$(awk '/^BUNDLED WITH$/ { getline; gsub(/^[[:space:]]+/, ""); print; exit }' "$repo_root/Gemfile.lock")"
plutobook_version="0.19.0"
plutobook_build_id="$plutobook_version-system-harfbuzz"
plutobook_prefix="$repo_root/tmp/plutobook-orb-install"
mise_bin="$HOME/.local/bin/mise"

step "Install missing system packages"
packages=(
  build-essential
  git
  pkg-config
  ninja-build
  pipx
  python3-pip
  libcairo2-dev
  libexpat1-dev
  libicu-dev
  libfreetype6-dev
  libfontconfig1-dev
  libharfbuzz-dev
  poppler-utils
)
missing_packages=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]})); then
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends "${missing_packages[@]}"
else
  echo "System packages already installed"
fi

step "Install Ruby $ruby_version"
if [[ ! -x "$mise_bin" ]]; then
  curl --proto '=https' --tlsv1.2 -fsSL https://mise.run | MISE_INSTALL_PATH="$mise_bin" sh
fi
"$mise_bin" settings add idiomatic_version_file_enable_tools ruby
"$mise_bin" install "ruby@$ruby_version"
if ! "$mise_bin" exec "ruby@$ruby_version" -- gem list bundler --installed --version "$bundler_version" >/dev/null; then
  "$mise_bin" exec "ruby@$ruby_version" -- gem install bundler --version "$bundler_version" --no-document
fi

step "Install Meson 1.3.2"
if ! "$HOME/.local/bin/meson" --version 2>/dev/null | grep -qx '1.3.2'; then
  pipx install --force 'meson==1.3.2'
fi
export PATH="$HOME/.local/bin:$PATH"

step "Build PlutoBook $plutobook_version"
export PAGE_PRINT_PLUTOBOOK_PREFIX="$plutobook_prefix"
export PKG_CONFIG_PATH="$plutobook_prefix/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="$plutobook_prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
installed_build_id=""
if [[ -f "$plutobook_prefix/.page-print-version" ]]; then
  installed_build_id="$(<"$plutobook_prefix/.page-print-version")"
fi
if [[ "$installed_build_id" != "$plutobook_build_id" ]] ||
   ! PKG_CONFIG_PATH="$PKG_CONFIG_PATH" pkg-config --exists "plutobook = $plutobook_version"; then
  source_dir="$repo_root/tmp/plutobook-orb-src"
  build_dir="$repo_root/tmp/plutobook-orb-build"
  rm -rf "$source_dir" "$build_dir" "$plutobook_prefix"
  git clone --depth 1 --branch "v$plutobook_version" https://github.com/plutoprint/plutobook.git "$source_dir"
  meson setup "$build_dir" "$source_dir" \
    --prefix="$plutobook_prefix" \
    --libdir=lib \
    --buildtype=release \
    -Dcpp_args="['-include', 'memory_resource']" \
    -Dcurl=disabled \
    -Dturbojpeg=disabled \
    -Dwebp=disabled \
    -Dtools=disabled \
    -Dtests=disabled \
    -Dexamples=disabled
  meson compile -C "$build_dir"
  meson install -C "$build_dir"
  printf '%s\n' "$plutobook_build_id" > "$plutobook_prefix/.page-print-version"
  rm -rf "$source_dir" "$build_dir"
else
  echo "PlutoBook $plutobook_version already installed"
fi

step "Configure login shells"
profile_marker="# page_print orb environment"
profile_end_marker="# end page_print orb environment"
if grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  sed -i '/^# page_print orb environment$/,/^# end page_print orb environment$/d' "$HOME/.bash_profile"
fi
cat >> "$HOME/.bash_profile" <<EOF
$profile_marker
if [[ "\${PWD}" == "$repo_root" ]]; then
  eval "\$("$mise_bin" activate bash)"
  export PAGE_PRINT_PLUTOBOOK_PREFIX="$plutobook_prefix"
  export PKG_CONFIG_PATH="$plutobook_prefix/lib/pkgconfig\${PKG_CONFIG_PATH:+:\$PKG_CONFIG_PATH}"
  export LD_LIBRARY_PATH="$plutobook_prefix/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
  export CONFIGURE_ARGS="--with-plutobook-include=$plutobook_prefix/include --with-plutobook-lib=$plutobook_prefix/lib"
fi
$profile_end_marker
EOF

step "Install locked Ruby dependencies"
"$mise_bin" exec "ruby@$ruby_version" -- bundle install

step "Orb setup complete"
